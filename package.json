{
  "name": "forma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:disabled-media": "node scripts/run-disabled-media-e2e.mjs",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:disabled-media",
    "test:e2e:ui": "playwright test --ui",
    "test:ollama": "tsx --conditions=react-server scripts/probe-ollama.ts",
    "test:cloudflare": "vitest run src/ai/__tests__/cloudflare-provider.contract.test.ts src/ai/__tests__/contract-probe.test.ts",
    "data:fetch": "node scripts/fetch-dataset.mjs",
    "data:import": "node scripts/import-dataset.mjs",
    "media:import": "node scripts/import-media.mjs",
    "data:curate": "node scripts/generate-curation.mjs",
    "data:build": "node scripts/build-catalog.mjs",
    "data:audit": "node scripts/audit-catalog.mjs",
    "validate:dataset": "node scripts/validate-dataset.mjs",
    "validate:curated": "node scripts/validate-curated.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "validate:generated": "node scripts/validate-generated.mjs",
    "validate:utf8": "node scripts/validate-utf8.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "types:cloudflare": "wrangler types",
    "validate:references": "tsx scripts/validate-design-reference.ts",
    "validate": "npm run validate:references && npm run validate:utf8 && npm run validate:dataset && npm run validate:curated && npm run validate:media && npm run validate:generated && npm run typecheck && npm run lint && npm run test && npm run build && npm run validate:media"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.27.0",
    "minisearch": "^7.2.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "@opennextjs/aws": {
      "@node-minify/core": "8.0.6"
    }
  }
}
