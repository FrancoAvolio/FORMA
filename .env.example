# AI provider: disabled | mock | ollama | cloudflare
AI_PROVIDER=ollama

# Local Ollama (server-only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
AI_TIMEOUT_MS=60000
AI_DEBUG_LOGS=true

# Cloudflare Workers AI model. The binding itself is configured in wrangler.jsonc.
CLOUDFLARE_AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
CLOUDFLARE_AI_STRUCTURED_MODE=function_calling
# Set only after the candidate passes the same external contract probe.
CLOUDFLARE_AI_FALLBACK_MODEL=

# Source exercise media is allowed only for local/private evaluation.
# It is disabled by default and is never copied into public production output.
EXERCISE_MEDIA_MODE=disabled
# Public feature switch. `false` always forces the neutral placeholder.
NEXT_PUBLIC_ENABLE_EXERCISE_MEDIA=false
# Development/private evaluation only; never set this in production.
EXERCISE_MEDIA_LOCAL_ROOT=.local-media/exercises-dataset
NEXT_PUBLIC_AUTOPLAY_EXERCISE_MEDIA=false
